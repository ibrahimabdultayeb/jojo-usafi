node_modules/
.pnpm-store/

# Next.js
.next/
out/

# Vercel
.vercel/

# secrets
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# Firebase / Google private credentials
firebase-adminsdk*.json
*service-account*.json
*serviceAccount*.json
credentials.json
credentials-*.json
secrets/
*.pem
*.key

# logs
*.log
npm-debug.log*
