pnpm-debug.log*

# test outputs
playwright-report/
test-results/
coverage/

# OS
.DS_Store
Thumbs.db

# Claude machine-specific settings
.claude/settings.local.json
CLAUDE.local.md

# Restored source inputs: the Product Master CSV and the approved product
# photography. These are source-only, read by scripts/build-catalogue.mjs, and
# their committed output lives in public/products and src/lib/catalogue/generated.
imports/

# temporary
tmp/
temp/

# TypeScript build info
tsconfig.tsbuildinfo

# Per-run database test manifest — machine-generated, never committed
tests/db/.run/

# Development QA staff record — machine-generated, holds no passwords, never committed
.qa-staff.local.json

# Vercel CLI — the project link, and any environment file it pulls down.
#
# `vercel link` appends a bare `.env*` here. That is too broad: it also matches
# `.env.example`, which is tracked on purpose and is the only record of which
# variables this application needs. The named secret files are already listed
# above; these two cover what the CLI itself creates.
.vercel
.env*.tmp
