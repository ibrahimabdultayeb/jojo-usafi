# =============================================================================
# Jojo Usafi - environment variables
#
# NAMES ONLY. Never commit a value into this file's real counterpart.
# Copy to .env.local and fill in there. .env.local is git-ignored.
#
# No Supabase project exists yet. Build 06 creates a FREE development project;
# until then every one of these is blank and nothing in the app reads them.
# =============================================================================

# --- Site --------------------------------------------------------------------
# Absolute base for canonical and hreflang URLs. No production domain has been
# chosen yet; local development needs nothing here.
NEXT_PUBLIC_SITE_URL=

# --- Supabase: public --------------------------------------------------------
# Safe in the browser. The anon key is designed to be public - Row Level
# Security is what protects the data behind it, not the secrecy of this key.
# The URL is the project API URL and ends in .supabase.co, NOT the dashboard
# address on supabase.com.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: privileged, server only ---------------------------------------
# BYPASSES ROW LEVEL SECURITY COMPLETELY. Read only by src/lib/supabase/admin.ts,
# which is server-only. Never prefix it NEXT_PUBLIC_, never send it to a browser,
# never paste it into a client component, never commit it.
# Needed only for the Google Sheet sync worker and maintenance jobs.
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL connection string, for `supabase db push` and migration
# tooling. Contains the database password. Never committed.
SUPABASE_DB_URL=

# --- Google Sheet synchronisation (Build 09) ---------------------------------
# NAMES ONLY, as everywhere in this file. The private key belongs in .env.local
# or a Vercel secret, never in the repository and never in a chat message.
#
# The service account is given access to ONE spreadsheet, by that spreadsheet
# being shared with its email address the way it would be shared with a
# colleague. The OAuth scope is 'spreadsheets' only - there is no Drive access,
# so it cannot see, list or open anything else.
#
# The private key is the multi-line PEM from the service-account JSON, with its
# newlines escaped (a backslash followed by the letter n) so it survives being
# one line of an environment variable.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The tab holding the Product Master. Defaults to 'Product Master' when unset.
GOOGLE_SHEETS_TAB=

# Bearer token the protected sync endpoint requires (POST /api/sync/catalogue).
# Nothing schedules that endpoint yet. Unset or shorter than 16 characters, the
# endpoint refuses EVERY request - a deployment that forgets it is closed, not
# open. Generate a long random value; never commit it.
SHEET_SYNC_WEBHOOK_SECRET=
RESERVATION_EXPIRY_JOB_SECRET=
